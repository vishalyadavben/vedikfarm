# Copy this file to .env in the repo root (used by docker-compose.yml) and fill in real values.
# Never commit the real .env file.

# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vedikfarm
DB_USER=vedikfarm
DB_PASSWORD=change_me_to_a_real_password
MYSQL_ROOT_PASSWORD=change_me_to_a_real_root_password

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes
JWT_ACCESS_EXPIRY_MIN=60
JWT_REFRESH_EXPIRY_DAYS=30

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://vedikfarm.in,https://www.vedikfarm.in

# --- Razorpay ---
# From the Razorpay dashboard: Settings > API Keys (use TEST keys until you're ready to go live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From: Settings > Webhooks, after you create the webhook pointing at /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudflare R2 (product images) ---
# From the R2 dashboard: create a bucket, then an API token with read+write access to it.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=vedikfarm-product-images
# Either the bucket's public r2.dev URL, or a custom domain you've connected to the bucket.
R2_PUBLIC_BASE_URL=

# --- Business details (used for GST calculation and shipping rules) ---
SELLER_STATE=Maharashtra
SHIPPING_FREE_ABOVE=999.00
SHIPPING_FLAT_FEE=49.00

# --- Email (order confirmations) - optional, checkout works fine without this configured ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
